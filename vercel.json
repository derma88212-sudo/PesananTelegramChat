{
  "version": 2,
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "functions": {
    "server.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "*.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server.ts"
    },
    {
      "source": "/((?!api/|assets/|favicon|manifest|icon|apple-touch|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
