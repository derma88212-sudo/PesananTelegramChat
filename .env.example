# =============================================================================
# TELEGRAM DIGITAL GOODS STORE — Production Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# --- Application ---
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com

# --- Admin Authentication (Zero-Fail Fallback) ---
# Instant login works WITHOUT any database connection!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=kuda2017
# Root admin (Supabase/Firestore default)
ADMIN_TELEGRAM_ID=123456789
ADMIN_TELEGRAM_IDS=123456789,987654321

# --- Telegram Bot ---
# Get from @BotFather - one per bot instance
BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Group/Channel ID for admin notifications & DB backups (negative number)
TELEGRAM_ADMIN_GROUP_ID=-1001234567890
TELEGRAM_CHANNEL_ID=-1001234567890

# --- Supabase (PostgreSQL) ---
# Get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Direct PostgreSQL connection (for migrations)
SUPABASE_DB_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# --- Google Cloud Firestore (Alternative/Backup DB) ---
# Service account JSON (base64 encoded) OR path to file
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=your-project-id

# --- Redis Cache & Sessions ---
# Railway/Upstash/Redis Cloud URL (redis:// or rediss://)
REDIS_URL=redis://localhost:6379

# --- MySQL / MariaDB (Optional) ---
MYSQL_URL=mysql://user:password@host:3306/database

# --- MongoDB (Optional) ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# --- NOWPayments (Auto Crypto Payments) ---
# Get from NOWPayments Dashboard
NOWPAYMENTS_API_KEY=your-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret
NOWPAYMENTS_SANDBOX=true

# --- Google Gemini AI (Optional) ---
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# --- Audio Alert ---
SOUND_PRESET=cash_register
SOUND_VOLUME=80
SOUND_CUSTOM_URL=