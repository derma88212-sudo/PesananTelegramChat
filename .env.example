
# ADMIN_TELEGRAM_ID / ADMIN_TELEGRAM_IDS: Strict Telegram admin IDs (comma separated)
# Only these IDs may open the /admin control center in the Telegram bot.
ADMIN_TELEGRAM_ID=
ADMIN_TELEGRAM_IDS=

# TELEGRAM_ADMIN_GROUP_ID: Group/chat ID receiving payment proofs & DB backups
TELEGRAM_ADMIN_GROUP_ID=

# PORT: HTTP port for the app (Docker / VPS deployments)
PORT=3000

